APP_URL=http://localhost:3000/
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
DATA_DIR=~/.local/state/keylearn

# Which peers may set X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host.
#
# Leave EMPTY when the server is exposed directly: forwarded headers are then
# ignored and the socket address is used. That matters because rate limiting and
# the adaptive CAPTCHA are keyed on the client address — trusting a header the
# client controls lets anyone rotate it and bypass both.
#
# Set it when running behind a reverse proxy or load balancer. Accepts a
# comma-separated list of proxy addresses, bare prefixes ("10.8."), or the
# shorthands "loopback" and "private".
#   TRUSTED_PROXIES=loopback
TRUSTED_PROXIES=

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=~/.local/state/keylearn/database.sqlite

# Email transport: "mailgun" (default) or "smtp" (Brevo, Gmail, any relay).
MAIL_TRANSPORT=smtp

# Mailgun transport.
MAIL_DOMAIN=localhost
MAIL_KEY=

# SMTP transport. For Brevo: host smtp-relay.brevo.com, port 587, user is
# the SMTP login shown under Brevo -> SMTP & API -> SMTP (xxx@smtp-brevo.com),
# password is the SMTP key generated there.
MAIL_SMTP_HOST=smtp-relay.brevo.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# Sender identity for either transport.
MAIL_FROM_ADDRESS=user@localhost
MAIL_FROM_NAME=KeyLearn

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials).
# The authorized redirect URI must be <APP_URL>auth/oauth-callback/google
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Microsoft sign-in (Azure Portal -> App registrations).
# The redirect URI must be <APP_URL>auth/oauth-callback/microsoft
# Leave blank and the Microsoft button is simply not shown on the sign-in page.
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
# Which Microsoft accounts may sign in: "common" (personal + any work/school
# tenant, the default), "consumers" (personal only), or a tenant id for one
# organisation. Because Microsoft Graph reports no email-verification state, an
# address from "common" is never used to claim an existing KeyLearn account —
# pin this to your own tenant if you need Microsoft addresses to be conclusive.
AUTH_MICROSOFT_TENANT=

# Facebook sign-in (Meta for Developers -> Apps -> Facebook Login).
# The redirect URI must be <APP_URL>auth/oauth-callback/facebook
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=

# --- Security features ---

# Refuse passwords that appear in public breach corpora, via the Have I Been
# Pwned k-anonymity range API (only a 5-character hash prefix leaves the server;
# the password never does). Set to false for offline or air-gapped installs.
BREACH_CHECK=true
BREACH_CHECK_THRESHOLD=10
BREACH_CHECK_TIMEOUT_MS=3000

# Cloudflare Turnstile — an adaptive CAPTCHA, applied only after repeated
# failures from one address. Leave the secret unset to disable entirely.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_FAIL_LIMIT=3
TURNSTILE_TIMEOUT_MS=5000

# Comma-separated list of email addresses allowed into the staff desk
# (/desk). Checked at request time, not stored in the database — granting
# or revoking staff access is now a deploy, not an in-app action. Leave
# empty and nobody can reach the desk, which is the safe default.
ADMIN_EMAILS=
STAFF_EMAILS=

# How long the staff audit log (sign-ins, reveals, replies, deletions, with
# the acting IP) is kept, in days. 0 keeps it forever, which is the shipped
# value; set a window and a daily sweep drops older rows. The learner-facing
# sign-in history is separate and always ages out at 30 days.
STAFF_AUDIT_RETENTION_DAYS=0

# How often each server process re-reads the site configuration that the
# control centre writes (the site_config table), in seconds. This is the
# window a change takes to reach every process, and the figure the control
# centre shows as its propagation promise; leave it at 30 unless you have a
# reason. Settings with an environment variable of their own (this file) are
# overridden by that variable while it is set, and the control centre shows
# such a row locked with the reason.
SITE_CONFIG_REFRESH_SECONDS=30

# Multiplayer limits. The game socket needs no account, so these bound what one
# client can consume.
# Live practice is unfinished — no join dialog, no way to land in the same room
# as somebody you know — so it is off. Off means gone: /multiplayer answers 404,
# the sitemap omits it, and the game socket and room list under /_/game/ answer
# 404 too. Turn this on when it is ready.
MULTIPLAYER_ENABLED=false
# Where the browser should reach the game worker. Leave EMPTY in production,
# where nginx forwards /_/game/ to it and the page can use its own origin. In
# development there is no proxy and the worker has its own port, so point at it
# — otherwise the socket dials the HTTP worker and fails with a 1006.
GAME_URL=
MULTIPLAYER_MAX_PLAYERS=500
MULTIPLAYER_MAX_PER_IP=8
# People per race. Ten rails is about as many as anyone can watch; a new room
# opens automatically whenever none has space, so this never makes anyone queue.
MULTIPLAYER_ROOM_SIZE=10
# Room stats name every connected player; keep this false outside a private
# dashboard.
MULTIPLAYER_STATS_PUBLIC=false

# Learner data (typing history, braille progress) is written to files under
# DATA_DIR and copied into the database at this interval, so a lost disk does
# not take every household's history with it. The files stay the working copy;
# nothing reads the database copy during normal operation. Unchanged files cost
# a hash and no write. Set DATA_SNAPSHOT=false to keep data on disk only.
DATA_SNAPSHOT=true
DATA_SNAPSHOT_MINUTES=15

# The scramble behind certificate numbers. Leave it unset and a key is
# generated once into DATA_DIR/certificate.key, which is what a single-server
# deployment wants. Set it explicitly when several machines issue certificates,
# because they have to agree — and set it before issuing any, since changing it
# changes what every certificate's number is.
CERTIFICATE_SECRET=

# Encrypts two-step-verification (TOTP) secrets at rest — same fallback as
# CERTIFICATE_SECRET above: leave it unset and a key is generated once into
# DATA_DIR/totp.key, which is what a single-server deployment wants. Set it
# explicitly when several machines verify sign-ins, because they have to
# agree; changing it makes every already-enrolled account's stored secret
# unreadable, forcing them to set two-step verification up again.
TOTP_ENCRYPTION_KEY=

# How often each server process re-reads the staff roster, in seconds.
# The control centre can tune it (ops.staffRefreshS); this wins while set.
STAFF_REFRESH_SECONDS=60

# The leaderboard's population rule: verified accounts and ranked learners
# needed before the board is shown at all. The control centre tunes both
# (leaderboard.minAccounts / minRanked); these win while set.
LEADERBOARD_MIN_ACCOUNTS=500
LEADERBOARD_MIN_RANKED=50

# Days an unconfirmed support ticket waits before it is dropped. The control
# centre can change it (retention.holdingQueueDays); this wins while set.
HOLDING_QUEUE_DAYS=7

# Hand-offs to the desk that failed: retry after this many minutes, give up
# after this many hours. Tunable in the control centre; env wins while set.
QDESK_RETRY_AFTER_MINUTES=5
QDESK_RETRY_GIVE_UP_HOURS=48

# Practice reminder after this many quiet days; the daily staff digest hour;
# the account-deletion sweep and data snapshot periods in minutes. All
# tunable in the control centre; each wins while set.
REMINDER_AFTER_DAYS=3
DIGEST_HOUR=8
ACCOUNT_DELETION_SWEEP_MINUTES=60
DATA_SNAPSHOT_MINUTES=15

# Session lifetime in seconds (14 days shipped). Shown read-only in the
# control centre; the server refuses to boot in production if weakened.
COOKIE_MAX_AGE=1209600

# Premium (control centre 3.3). Sell premium refuses to turn on until BOTH are
# set; one without the other is logged as a misconfiguration at boot.
#PADDLE_API_KEY=
#PADDLE_SECRET_KEY=
