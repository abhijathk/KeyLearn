APP_URL=http://localhost:3000/
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
DATA_DIR=~/.local/state/keylearn

# Which peers may set X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host.
#
# Leave EMPTY when the server is exposed directly: forwarded headers are then
# ignored and the socket address is used. That matters because rate limiting and
# the adaptive CAPTCHA are keyed on the client address — trusting a header the
# client controls lets anyone rotate it and bypass both.
#
# Set it when running behind a reverse proxy or load balancer. Accepts a
# comma-separated list of proxy addresses, bare prefixes ("10.8."), or the
# shorthands "loopback" and "private".
#   TRUSTED_PROXIES=loopback
TRUSTED_PROXIES=

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=~/.local/state/keylearn/database.sqlite

# Email transport: "mailgun" (default) or "smtp" (Brevo, Gmail, any relay).
MAIL_TRANSPORT=smtp

# Mailgun transport.
MAIL_DOMAIN=localhost
MAIL_KEY=

# SMTP transport. For Brevo: host smtp-relay.brevo.com, port 587, user is
# the SMTP login shown under Brevo -> SMTP & API -> SMTP (xxx@smtp-brevo.com),
# password is the SMTP key generated there.
MAIL_SMTP_HOST=smtp-relay.brevo.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# Sender identity for either transport.
MAIL_FROM_ADDRESS=user@localhost
MAIL_FROM_NAME=KeyLearn

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials).
# The authorized redirect URI must be <APP_URL>auth/oauth-callback/google
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Microsoft sign-in (Azure Portal -> App registrations).
# The redirect URI must be <APP_URL>auth/oauth-callback/microsoft
# Leave blank to hide the Microsoft button's backend (the button will 500 until set).
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
# Which Microsoft accounts may sign in: "common" (personal + any work/school
# tenant, the default), "consumers" (personal only), or a tenant id for one
# organisation. Because Microsoft Graph reports no email-verification state, an
# address from "common" is never used to claim an existing KeyLearn account —
# pin this to your own tenant if you need Microsoft addresses to be conclusive.
AUTH_MICROSOFT_TENANT=

# Facebook sign-in (Meta for Developers -> Apps -> Facebook Login).
# The redirect URI must be <APP_URL>auth/oauth-callback/facebook
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=

# --- Security features ---

# Refuse passwords that appear in public breach corpora, via the Have I Been
# Pwned k-anonymity range API (only a 5-character hash prefix leaves the server;
# the password never does). Set to false for offline or air-gapped installs.
BREACH_CHECK=true
BREACH_CHECK_THRESHOLD=10
BREACH_CHECK_TIMEOUT_MS=3000

# Cloudflare Turnstile — an adaptive CAPTCHA, applied only after repeated
# failures from one address. Leave the secret unset to disable entirely.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_FAIL_LIMIT=3
TURNSTILE_TIMEOUT_MS=5000

# Multiplayer limits. The game socket needs no account, so these bound what one
# client can consume.
# Live practice is unfinished — no join dialog, no way to land in the same room
# as somebody you know — so the navigation link is hidden. Turn this on when it
# is ready; the page itself is always reachable by URL.
MULTIPLAYER_ENABLED=false
# Where the browser should reach the game worker. Leave EMPTY in production,
# where nginx forwards /_/game/ to it and the page can use its own origin. In
# development there is no proxy and the worker has its own port, so point at it
# — otherwise the socket dials the HTTP worker and fails with a 1006.
GAME_URL=
MULTIPLAYER_MAX_PLAYERS=500
MULTIPLAYER_MAX_PER_IP=8
# People per race. Ten rails is about as many as anyone can watch; a new room
# opens automatically whenever none has space, so this never makes anyone queue.
MULTIPLAYER_ROOM_SIZE=10
# Room stats name every connected player; keep this false outside a private
# dashboard.
MULTIPLAYER_STATS_PUBLIC=false
