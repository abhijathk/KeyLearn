root = true

[*]
charset = utf-8
indent_size = 2
indent_style = space
max_line_length = 80
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Kotlin's official style is four spaces and 100 columns, which is not this
# repository's TypeScript style. There is no Kotlin source here — only the
# practice corpus in @keybr/content-snippets, which ktlint checks through this
# section. See packages/keybr-content-snippets/lib/snippets/kotlin-lang.ts.
[*.kt]
indent_size = 4
max_line_length = 100
ktlint_code_style = ktlint_official
